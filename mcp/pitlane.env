# pitlane.env — semantic search configuration for the local Unsloth Studio
# embedding server (:1235, launched by ~/Projects/unsloth/embedding.sh).
#
# Sourced by .opencode/mcp/setup.sh (index time) and synced to ~/.pitlane/env,
# which ~/.local/bin/pitlane-mcp (the MCP wrapper) injects into the server
# process at spawn time. Keep secrets OUT of this file: the API key is
# resolved at runtime from PITLANE_EMBED_API_KEY_FILE.
#
# Non-obvious facts:
#   - The embedding model is Google embeddinggemma-2 (Q8_0 GGUF). It has no
#     built-in task-prefix mode in pitlane (only "nomic" exists), so the
#     prefixes below are applied verbatim. Trailing spaces are significant —
#     keep them when editing.
#   - PITLANE_EXCLUDE_DIRS takes comma-separated directory NAMES (not globs)
#     and applies process-wide, including MCP-triggered re-indexes.
#   - PITLANE_SEMANTIC_QUERY_TIMEOUT_MS guards query-time embedding calls
#     against the local server (30 s — the box also serves LLMs, so single
#     embedding requests can queue behind generation).

PITLANE_EMBED_URL=http://127.0.0.1:1235/v1/embeddings
PITLANE_EMBED_MODEL=embeddinggemma-2-Q8_0
PITLANE_EMBED_API_KEY_FILE="$HOME/.unsloth/harness-embed.key"
PITLANE_EMBED_QUERY_PREFIX='task: search result | query: '
PITLANE_EMBED_DOCUMENT_PREFIX='title: none | text: '
PITLANE_SEMANTIC_QUERY_TIMEOUT_MS=30000
PITLANE_EXCLUDE_DIRS=not-used
