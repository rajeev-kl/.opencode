{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "Manager",
  "provider": {
    "unsloth": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "proart-px13",
      "options": {
        "baseURL": "http://proart-px13.local:1234/v1/",
        "apiKey": "{env:UNSLOTH_API_KEY}"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8-27b",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      }
    }
  },
  "mcp": {
    "pitlane": {
      "type": "local",
      "command": ["pitlane-mcp"],
      "enabled": true
    }
  }
}