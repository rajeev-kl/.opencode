{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "Manager",
  "provider": {
    "proart-lms": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ornith (proart-px13)",
      "options": {
        "baseURL": "http://proart-px13.local:1234/v1/",
        "apiKey": "EMPTY"
      },
      "models": {
        "ornith-1.0-35b": {
          "name": "Ornith",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 16386
          }
        }
      }
    }
  },
  "plugin": [
    "./tools/cli-claude.ts",
    "./tools/cli-codex.ts",
    "./tools/cli-antigravity.ts"
  ],

  "agent": {
    "Manager": {
      "description": "Primary orchestrator — delegates to subagents and CLI agents. Entry point for all work.",
      "mode": "primary"
    },
    "bga": {
      "description": "background agent — handles delegated tasks from the Manager"
    }
  }
}